<div class="card">
  <%= image_tag "logo.jpg", alt: "", class: "card__logo" %>
  <h1 class="card__title">Signed in</h1>
  <p class="card__subtitle"><%= current_user.name %> &lt;<%= current_user.email %>&gt;</p>

  <%= button_to "Sign out", logout_path, method: :delete, class: "button" %>

  <% if current_user.password? %>
    <p class="footnote"><%= link_to "Change your password", edit_password_path %></p>
  <% end %>
</div>
