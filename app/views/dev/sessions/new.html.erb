<div class="card">
  <%= image_tag "logo.jpg", alt: "", class: "card__logo" %>
  <h1 class="card__title">Development sign-in</h1>
  <p class="card__subtitle">Pick an identity from <code>config/dev_users.yml</code></p>

  <ul class="users">
    <% @users.each do |user| %>
      <li>
        <%= button_to dev_sign_in_path, params: { email: user[:email] }, class: "button" do %>
          <span class="user__name"><%= user[:name] %></span>
          <span class="user__email"><%= user[:email] %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <p class="footnote"><%= link_to "Back to sign in", sign_in_path %></p>
</div>
